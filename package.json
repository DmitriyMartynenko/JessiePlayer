{
  "name": "jessie-player",
  "productName": "Jessie Player",
  "version": "1.0.0",
  "author": "Dmytro martynenko <dmitriy.martynenko150@gmail.com>",
  "description": "Animation player for JSON, Lottie, and WebM",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5174 && cross-env ELECTRON_RENDERER_URL=http://localhost:5174 electron .\"",
    "electron:build": "npm run build && electron .",
    "electron:run": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "pack:bundle": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/pack-installer-bundle.ps1",
    "dist:mac": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "gifenc": "^1.0.3",
    "image-size": "^2.0.2",
    "jszip": "^3.10.1",
    "lottie-web": "^5.13.0",
    "mp4-muxer": "^5.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.1.18",
    "webm-muxer": "^5.1.4",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^30.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.jessieplayer.app",
    "productName": "Jessie Player",
    "publish": {
      "provider": "github",
      "owner": "DmitriyMartynenko",
      "repo": "JessiePlayer"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/images/**/*"
    ],
    "fileAssociations": [
      {
        "ext": "json",
        "name": "JSON Animation",
        "description": "JSON / Lottie animation"
      },
      {
        "ext": "lottie",
        "name": "Lottie",
        "description": "Lottie animation"
      },
      {
        "ext": "webm",
        "name": "WebM Video",
        "description": "WebM video"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/images/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "src/images/icon.ico",
      "uninstallerIcon": "src/images/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "src/images/icon.png",
      "category": "public.app-category.video"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
